install.packages('corrplot')
install.packages("corrplot")
scale_to_range <- function(x) {
max_abs <- max(abs(x), na.rm = TRUE)
if (max_abs == 0) return(x)  # Avoid division by zero
x / max_abs
}
matrix_df <- scale_to_range(matrix_df)
corrplot::corrplot(matrix_df, method = 'ellipse', order = 'AOE', type = 'upper')
is.na.data.frame(matrix_df)
matrix_df[is.na(matrix_df)] <- 1
corrplot::corrplot(matrix_df, method = 'ellipse', order = 'AOE', type = 'upper')
