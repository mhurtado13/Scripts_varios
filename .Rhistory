dplyr::distinct(Resample, dplyr::across(all_of(hp_cols_all))) %>%
dplyr::count(dplyr::across(all_of(hp_cols_all)), name = "n_resamples") %>%
dplyr::arrange(desc(n_resamples))
# Expected number of resamples (folds × repeats)
