genes = sig_file$NAME
sig_file <- sig_file %>%
column_to_rownames("NAME") %>%
apply(., 2, as.numeric) %>%
data.frame() %>%
mutate("Genes" = genes) %>%
column_to_rownames("Genes") %>%
as.matrix()
deconvolution = deconvolute_bseqsc(bulk_gene_expression = counts, signature = sig_file,
log = T, verbose = T)
deconvolution = deconvolute_dwls(bulk_gene_expression = counts, signature = sig_file,
dwls_submethod = "DampenedWLS", verbose = T)
deconvolution = deconvolute_scaden(bulk_gene_expression = counts, signature = sig_file, verbose = T)
deconvolution = deconvolute_scaden(bulk_gene_expression = counts, signature = '~/Documents/CellTFusion/user_projects/src/signatures/', verbose = T)
deconvolution = deconvolute_scdc(bulk_gene_expression = counts, signature = sig_file, verbose = T)
deconvolution = deconvolute_scdc(bulk_gene_expression = counts, single_cell_object = single_cell_object,
cell_type_annotations = cell_type_annotations, batch_ids = batch_ids, verbose = T)
deconvolution = deconvolute_scdc(bulk_gene_expression = as.matrix(counts), single_cell_object = single_cell_object,
cell_type_annotations = cell_type_annotations, batch_ids = batch_ids, verbose = T)
