# Find the common genes across all data frames
common_genes <- Reduce(intersect, lapply(data_leucegene, function(df) df$V4))
# Subset each data frame to include only the common genes
df_list_filtered <- lapply(data_leucegene, function(df) df[df$V4 %in% common_genes, ])
