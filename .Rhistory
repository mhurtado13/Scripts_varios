library(omnideconv)
set.seed(123)
counts = read.csv("~/Downloads/RawFiles/Counts_Vanderbilt.csv", row.names = 1)
sc_rnaseq = LoadH5Seurat("~/all_samples.h5seurat",  assays = "RNA")
sc_rnaseq <- subset(sc_rnaseq, subset = n_genes > 200 & total_counts < 2500 & pct_counts_mt < 5)
sc_rnaseq <- sc_rnaseq[, 1:100]
library(stringr)
rownames(counts) <- str_replace(rownames(counts),
pattern = ".[0-9]+$",
replacement = "")
library(biomaRt)
mart <- useMart("ensembl", dataset = "hsapiens_gene_ensembl")
gene_ids <- rownames(counts)
# Get gene type annotations
annotations <- getBM(attributes = c("ensembl_gene_id", "gene_biotype"),
filters = "ensembl_gene_id",
values = gene_ids,
mart = mart)
# Filter annotations to keep only coding genes
coding_genes <- annotations %>%
filter(gene_biotype == "protein_coding") %>%
pull(ensembl_gene_id)
counts = counts[rownames(counts) %in% coding_genes,]
# Change to gene SYMBOL
library(org.Hs.eg.db)
library(plotly)
library(tibble)
entrz <- AnnotationDbi::select(org.Hs.eg.db, keys = rownames(counts), columns = "SYMBOL", keytype = "ENSEMBL") %>%
distinct(SYMBOL, .keep_all=T) %>%
filter(ENSEMBL %in% rownames(counts)) %>%
group_by(ENSEMBL) %>%
slice(1) %>%
ungroup()
counts = counts %>%
rownames_to_column("Genes") %>%
filter(Genes %in% entrz$ENSEMBL) %>%
mutate(Symbol = entrz$SYMBOL) %>%
na.omit() %>%
remove_rownames() %>%
column_to_rownames("Symbol") %>%
dplyr::select(-Genes)
# Get gene type annotations
annotations_symbol <- getBM(attributes = c("hgnc_symbol", "gene_biotype"),
filters = "hgnc_symbol",
values = rownames(counts),
mart = mart)
# Filter annotations to keep only coding genes
coding_genes <- annotations_symbol %>%
filter(gene_biotype == "protein_coding") %>%
pull(hgnc_symbol)
counts = counts[rownames(counts) %in% coding_genes,]
norm_counts = ADImpute::NormalizeTPM(counts, log=T)
sc_rnaseq = sc_rnaseq[rownames(sc_rnaseq)%in%coding_genes,]
single_cell_object = as.matrix(sc_rnaseq@assays$RNA@data)
single_cell_object_scale = as.matrix(sc_rnaseq@assays$RNA@scale.data)
cell_type_annotations = sc_rnaseq@meta.data$annotated_ct
batch_ids = sc_rnaseq@meta.data$sample
rm(sc_rnaseq)
gc()
sig_file = read.delim2('~/Documents/CellTFusion/user_projects/src/signatures/CBSX-Melanoma-scRNAseq.txt')
genes = sig_file$NAME
sig_file <- sig_file %>%
column_to_rownames("NAME") %>%
apply(., 2, as.numeric) %>%
data.frame() %>%
mutate("Genes" = genes) %>%
column_to_rownames("Genes") %>%
as.matrix()
deconvolution = deconvolute_bseqsc(bulk_gene_expression = counts, signature = sig_file,
log = T, verbose = T)
deconvolution = deconvolute_dwls(bulk_gene_expression = counts, signature = sig_file,
dwls_submethod = "DampenedWLS", verbose = T)
deconvolution = deconvolute_scaden(bulk_gene_expression = counts, signature = sig_file, verbose = T)
deconvolution = deconvolute_scaden(bulk_gene_expression = counts, signature = '~/Documents/CellTFusion/user_projects/src/signatures/', verbose = T)
deconvolution = deconvolute_scdc(bulk_gene_expression = counts, signature = sig_file, verbose = T)
deconvolution = deconvolute_scdc(bulk_gene_expression = counts, single_cell_object = single_cell_object,
cell_type_annotations = cell_type_annotations, batch_ids = batch_ids, verbose = T)
deconvolution = deconvolute_scdc(bulk_gene_expression = as.matrix(counts), single_cell_object = single_cell_object,
cell_type_annotations = cell_type_annotations, batch_ids = batch_ids, verbose = T)
sc_rnaseq = LoadH5Seurat("~/all_samples.h5seurat",  assays = "RNA")
sc_rnaseq <- subset(sc_rnaseq, subset = n_genes > 200 & total_counts < 2500 & pct_counts_mt < 5)
sc_rnaseq = sc_rnaseq[rownames(sc_rnaseq)%in%coding_genes,]
single_cell_object = as.matrix(sc_rnaseq@assays$RNA@data)
single_cell_object_scale = as.matrix(sc_rnaseq@assays$RNA@scale.data)
cell_type_annotations = sc_rnaseq@meta.data$annotated_ct
batch_ids = sc_rnaseq@meta.data$sample
rm(sc_rnaseq)
gc()
deconvolution = deconvolute_scdc(bulk_gene_expression = as.matrix(counts), single_cell_object = single_cell_object,
cell_type_annotations = cell_type_annotations, batch_ids = batch_ids, verbose = T)
signature <- omnideconv::build_model(single_cell_object, as.character(cell_type_annotations), method = "scaden") #does not return signature
signature <- omnideconv::build_model(bulk_gene_expression = counts, single_cell_object, as.character(cell_type_annotations), method = "scaden") #does not return signature
signature <- omnideconv::build_model(single_cell_object, as.character(cell_type_annotations), method = "cpm") #does not return signature
deconvolution = deconvolute_dwls(bulk_gene_expression = counts, signature = sig_file,
dwls_submethod = "DampenedWLS", verbose = T)
