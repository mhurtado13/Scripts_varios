rowMeans(pathway_matrix[, pathways, drop = FALSE], na.rm = TRUE)
})
cluster_scores <- as.data.frame(cluster_scores)
patient_classification <- apply(cluster_scores, 1, function(row) {
names(which.max(row))  # assign patient to cluster with highest average score
})
patient_TME <- cluster_tme[patient_classification]
patient_TME
patient_TME <- stats::setNames(cluster_tme[patient_classification], rownames(pathway_matrix)) ## Patient names need to be in the same order!!
patient_TME
clusters_global
cluster_tme
names(clusters_global)
cluster_tme
clusters_global <- setNames(clusters_global, cluster_tme[names(clusters_global)])
clusters_global
# Classify patients
classiy_patient_TME = function(deconv_subgroups, pathway_matrix){
#deconv_matrix: rows = deconv features, columns = pathways
global_x <- CellTFusion::compute.modules.relationship(deconv_subgroups[["Deconvolution matrix"]], pathway_matrix, return = TRUE, plot = FALSE)
# Distance and clustering
d_global <- dist(t(global_x[[1]]))  # pathways are columns
hc_global <- hclust(d_global)
# Determine optimal k using silhouette
library(factoextra)
silhouette <- fviz_nbclust(as.matrix(t(global_x[[1]])), factoextra::hcut, method = "silhouette")
k_cluster <- silhouette$data$clusters[which.max(silhouette$data$y)]
# Cut tree and define pathway clusters
clusters_global <- cutree(hc_global, k = k_cluster)
clusters_global <- split(names(clusters_global), clusters_global)
names(clusters_global) <- paste0("Cluster_", seq_along(clusters_global))
# Automatic TME annotation based on pathway composition
tme_annotation <- c(
"Androgen" = "mixed",
"JAK.STAT" = "immunoactive",
"NFkB" = "suppressive",
"Trail" = "immunoactive",
"WNT" = "suppressive",
"p53" = "mixed",
"EGFR" = "suppressive",
"Estrogen" = "mixed",
"Hypoxia" = "suppressive",
"MAPK" = "mixed",
"PI3K" = "suppressive",
"TGFb" = "suppressive",
"TNFa" = "immunoactive",
"VEGF" = "suppressive"
)
cluster_tme <- sapply(clusters_global, function(paths) {
effects <- tme_annotation[paths]
n_immunoactive <- sum(effects == "immunoactive")
n_suppressive <- sum(effects == "suppressive")
if(n_immunoactive > n_suppressive) {
return("immunoactive")
} else if(n_suppressive > n_immunoactive) {
return("suppressive")
} else {
return("mixed")
}
})
# pathway_matrix: rows = patients, columns = pathways
# Compute first principal component (eigenvector) for each cluster
cluster_scores <- sapply(clusters_global, function(pathways) {
X <- pathway_matrix[, pathways, drop = FALSE]
pc1 <- prcomp(X, center = TRUE, scale. = TRUE)$x[,1]  # first principal component
# Make sure direction is positive
if(mean(pc1) < 0) pc1 <- -pc1  #In PCA, the direction of the eigenvector is arbitrary
pc1
})
cluster_scores <- as.data.frame(cluster_scores)
patient_classification <- apply(cluster_scores, 1, function(row) {
names(which.max(row))  # assign patient to cluster with highest average score
})
patient_TME <- cluster_tme[patient_classification]
patient_TME <- stats::setNames(cluster_tme[patient_classification], rownames(pathway_matrix)) ## Patient names need to be in the same order!!
clusters_global <- setNames(clusters_global, cluster_tme[names(clusters_global)])
return(list(patient_TME, clusters_global))
}
res = classiy_patient_TME(dt, pathways)
patient_classification = res[[1]]
clusters = res[[2]]
clusters
patient_classification
patient_TME_table <- data.frame(
Sample = names(patient_classification),
TME = unname(patient_classification),
row.names = NULL,
stringsAsFactors = FALSE
)
write.csv(patient_TME_table, file = "Patients_classification.csv")
