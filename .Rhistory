# param_aggr$summary already contains:
#   auc_mean, auc_median, auc_sd, ... per parameter
param_summary <- param_aggr$summary
best_param <- param_summary %>%
arrange(desc(auc_median)) %>%
slice(1) %>%
pull(parameter)
