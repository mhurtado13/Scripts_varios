library(Seurat)
library(SeuratDisk)
library(patchwork)
library(ggplot2)
library(dplyr)
library(omnideconv)
library(viper)
library(decoupleR)
set.seed(123)
#counts = read.csv("~/Downloads/RawFiles/Counts_Vanderbilt.csv", row.names = 1)
seurat_anndata = LoadH5Seurat("~/all_samples.h5seurat",  assays = "RNA")
Idents(seurat_anndata) = seurat_anndata@meta.data$annotated_ct
DimPlot(seurat_anndata, reduction="umap", label = T)
NK_cells = subset(seurat_anndata, idents = "NK cells", invert = FALSE)
nk_counts = as.matrix(NK_cells@assays$RNA@data)
nk_tfs = compute.TFs.activity(nk_counts)
NK_cells[["TF"]] <- CreateAssayObject(counts = t(nk_tfs))
DefaultAssay(NK_cells) = "TF"
View(NK_cells)
#Re-clustering
NK_cells <- RunPCA(NK_cells, features = colnames(nk_tfs))
NK_cells@assays$TF@scale.data = as.matrix(t(nk_tfs))
#Re-clustering
NK_cells <- RunPCA(NK_cells, features = colnames(nk_tfs))
ElbowPlot(NK_cells)
NK_cells = FindNeighbors(NK_cells, dims = 1:10, graph.name = c("TF_nn","TF_SNN"))
NK_cells = FindClusters(NK_cells, algorithm= 1, resolution = 0.2, graph.name = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, dims = 1:10, graph = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, graph = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, graph = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, graph = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, dims = 1:10)
DimPlot(NK_cells, reduction="umap", label = T, pt.size = 0.5)
NK_cells = FindClusters(NK_cells, algorithm= 1, resolution = 0.5, graph.name = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, dims = 1:10)
DimPlot(NK_cells, reduction="umap", label = T, pt.size = 0.5)
NK_cells[["TF"]] <- CreateAssayObject(counts = nk_tfs)
DimPlot(NK_cells, reduction="umap", label = T, pt.size = 0.5)
