# Classify patients
classiy_patient_TME = function(deconv_subgroups, pathway_matrix){
#deconv_matrix: rows = deconv features, columns = pathways
global_x <- CellTFusion::compute.modules.relationship(deconv_subgroups[["Deconvolution matrix"]], pathway_matrix, return = TRUE, plot = FALSE)
# Distance and clustering
d_global <- dist(t(global_x[[1]]))  # pathways are columns
hc_global <- hclust(d_global)
# Determine optimal k using silhouette
library(factoextra)
silhouette <- fviz_nbclust(as.matrix(t(global_x[[1]])), factoextra::hcut, method = "silhouette")
k_cluster <- silhouette$data$clusters[which.max(silhouette$data$y)]
# Cut tree and define pathway clusters
clusters_global <- cutree(hc_global, k = k_cluster)
clusters_global <- split(names(clusters_global), clusters_global)
names(clusters_global) <- paste0("Cluster_", seq_along(clusters_global))
# pathway_matrix: rows = patients, columns = pathways
cluster_scores <- sapply(clusters_global, function(pathways) {
rowMeans(pathway_matrix[, pathways, drop = FALSE], na.rm = TRUE)
})
cluster_scores <- as.data.frame(cluster_scores)
patient_classification <- apply(cluster_scores, 1, function(row) {
names(which.max(row))  # assign patient to cluster with highest average score
})
return(patient_classification)
}
# Classify patients
classiy_patient_TME = function(deconv_subgroups, pathway_matrix){
#deconv_matrix: rows = deconv features, columns = pathways
global_x <- CellTFusion::compute.modules.relationship(deconv_subgroups[["Deconvolution matrix"]], pathway_matrix, return = TRUE, plot = FALSE)
# Distance and clustering
d_global <- dist(t(global_x[[1]]))  # pathways are columns
hc_global <- hclust(d_global)
# Determine optimal k using silhouette
library(factoextra)
silhouette <- fviz_nbclust(as.matrix(t(global_x[[1]])), factoextra::hcut, method = "silhouette")
k_cluster <- silhouette$data$clusters[which.max(silhouette$data$y)]
# Cut tree and define pathway clusters
clusters_global <- cutree(hc_global, k = k_cluster)
clusters_global <- split(names(clusters_global), clusters_global)
names(clusters_global) <- paste0("Cluster_", seq_along(clusters_global))
# pathway_matrix: rows = patients, columns = pathways
cluster_scores <- sapply(clusters_global, function(pathways) {
rowMeans(pathway_matrix[, pathways, drop = FALSE], na.rm = TRUE)
})
cluster_scores <- as.data.frame(cluster_scores)
patient_classification <- apply(cluster_scores, 1, function(row) {
names(which.max(row))  # assign patient to cluster with highest average score
})
return(list(patient_classification, clusters_global))
}
