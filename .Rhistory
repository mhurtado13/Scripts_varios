library(Seurat)
library(SeuratDisk)
library(patchwork)
library(ggplot2)
library(dplyr)
library(omnideconv)
library(viper)
library(decoupleR)
set.seed(123)
#counts = read.csv("~/Downloads/RawFiles/Counts_Vanderbilt.csv", row.names = 1)
seurat_anndata = LoadH5Seurat("~/all_samples.h5seurat",  assays = "RNA")
Idents(seurat_anndata) = seurat_anndata@meta.data$annotated_ct
DimPlot(seurat_anndata, reduction="umap", label = T)
NK_cells = subset(seurat_anndata, idents = "NK cells", invert = FALSE)
nk_counts = as.matrix(NK_cells@assays$RNA@data)
nk_tfs = compute.TFs.activity(nk_counts)
NK_cells[["TF"]] <- CreateAssayObject(counts = t(nk_tfs))
DefaultAssay(NK_cells) = "TF"
View(NK_cells)
#Re-clustering
NK_cells <- RunPCA(NK_cells, features = colnames(nk_tfs))
NK_cells@assays$TF@scale.data = as.matrix(t(nk_tfs))
#Re-clustering
NK_cells <- RunPCA(NK_cells, features = colnames(nk_tfs))
ElbowPlot(NK_cells)
NK_cells = FindNeighbors(NK_cells, dims = 1:10, graph.name = c("TF_nn","TF_SNN"))
NK_cells = FindClusters(NK_cells, algorithm= 1, resolution = 0.2, graph.name = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, dims = 1:10, graph = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, graph = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, graph = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, graph = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, dims = 1:10)
DimPlot(NK_cells, reduction="umap", label = T, pt.size = 0.5)
NK_cells = FindClusters(NK_cells, algorithm= 1, resolution = 0.5, graph.name = "TF_SNN")
NK_cells <- RunUMAP(NK_cells, dims = 1:10)
DimPlot(NK_cells, reduction="umap", label = T, pt.size = 0.5)
NK_cells[["TF"]] <- CreateAssayObject(counts = nk_tfs)
DimPlot(NK_cells, reduction="umap", label = T, pt.size = 0.5)
devtools::create("~/Documents/CellTFusion")
library(Seurat)
library(SeuratDisk)
library(patchwork)
library(ggplot2)
library(dplyr)
library(omnideconv)
library(viper)
library(decoupleR)
set.seed(123)
seurat_anndata = LoadH5Seurat("~/all_samples.h5seurat",  assays = "RNA")
Idents(seurat_anndata) = seurat_anndata@meta.data$annotated_ct
DimPlot(seurat_anndata, reduction="umap", label = T)
library(hdWGCNA)
data <- SetupForWGCNA(
seurat_anndata,
gene_select = "fraction", # the gene selection approach
fraction = 0.05, # fraction of cells that a gene needs to be expressed in order to be included
wgcna_name = "MetaCells" # the name of the hdWGCNA experiment
)
rm(seurat_anndata)
gc()
# construct metacells  in each group
seurat_obj <- MetacellsByGroups(
seurat_obj = data,
min_cells = 100,
group.by = c("annotated_ct"), # specify the columns in seurat_obj@meta.data to group by
reduction = 'pca', # select the dimensionality reduction to perform KNN on
k = 25, # nearest-neighbors parameter
max_shared = 15, # maximum number of shared cells between two metacells
ident.group = 'annotated_ct'
)
rm(data)
gc()
metacell_obj <- GetMetacellObject(seurat_obj)
rm(seurat_obj)
gc()
View(metacell_obj)
View(metacell_obj@meta.data)
Idents(metacell_obj)
cell_clusters = list()
iter = 1
i = unique(metacell_obj@meta.data$annotated_ct)[2]
cluster = subset(metacell_obj, idents = i, invert = FALSE)
cell_clusters[[iter]] = as.matrix(cluster@assays$RNA@data)
View(cell_clusters)
View(cell_clusters[[1]])
cell_clusters = list()
iter = 1
for (i in unique(metacell_obj@meta.data$annotated_ct)) {
cluster = subset(metacell_obj, idents = i, invert = FALSE)
cell_clusters[[iter]] = as.matrix(cluster@assays$RNA@data)
names(cell_clusters)[iter] = i
iter = iter + 1
}
rm(metacell_obj, cluster)
gc()
View(cell_clusters)
source("compute.TFs.activity.R")
source("compute.TFs.activity.R")
tfs_clusters = list()
for (i in 1:length(cell_clusters)) {
tfs_clusters[[i]] = compute.TFs.activity(cell_clusters[[i]])
names(tfs_clusters)[i] = names(cell_clusters)[i]
}
gc()
