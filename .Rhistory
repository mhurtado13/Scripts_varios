# General function to plot correlations
plot_cell_correlation <- function(groundtruth_col, deconv_pattern, spatial_data, deconv_data) {
prop_ground = spatial_data[,groundtruth_col]
prop_estimates = deconv_data[, grep(deconv_pattern, colnames(deconv_data))]
for (i in 1:ncol(prop_estimates)) {
name_method = colnames(prop_estimates)[i]
data = data.frame("Deconvolution" = prop_estimates[,i],
"Groundtruth" = prop_ground)
# Calculate correlation
cor_test <- stats::cor.test(data[,"Deconvolution"], data[,"Groundtruth"], method = "pearson")
# Extract r and p-value
r_value <- round(cor_test$estimate, 2)
p_value <- signif(cor_test$p.value, 2)
# Create regression plot with ggplot2
p = ggplot(data, aes_string(x = "Deconvolution", y = "Groundtruth")) +
geom_point() +  # Scatter plot
geom_smooth(method = "lm", color = "blue", se = FALSE) +  # Linear regression line
labs(x = name_method, y = "Groundtruth", title = paste0(groundtruth_col, "_", deconv_pattern, "_correlation")) +
annotate("text", x = Inf, y = Inf, hjust = 1.1, vjust = 1.5,
label = paste("r =", r_value, "\np =", p_value),
size = 4, color = "black") +
theme_minimal()
print(p)
}
}
